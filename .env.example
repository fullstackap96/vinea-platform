# Optional outbound email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DEMO_REQUEST_TO_EMAIL=
REQUEST_NOTIFICATION_TO_EMAIL=
VINEA_EMAIL_LOGO_URL=

# Optional Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
