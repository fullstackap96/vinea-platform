# Vinea local/deployment environment contract.
# Keep values blank until they are provided through an approved secret store.

# Core application and Supabase access
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staff access and scheduled-job authorization
STAFF_ALLOWLIST_EMAILS=
